{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode",
    "openrouter",
    "agentplatform"
  ],
  "watcher": {
    "ignore": [
      ".venv/**",
      "**/__pycache__/**",
      ".git/**",
      ".bootstrap/**",
      "node_modules/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/htmlcov/**"
    ]
  },
  "provider": {
    "agentplatform": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentPlatform",
      "options": {
        "baseURL": "https://api.agentplatform.ru/v1",
        "apiKey": "{env:AGENTPLATFORM_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1000000,
            "output": 16384
          },
          "options": {
            "provider": {
              "sort": "throughput"
            }
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1000000,
            "output": 16384
          },
          "options": {
            "provider": {
              "sort": "throughput"
            }
          }
        },
        "qwen/qwen3-coder": {
          "name": "Qwen3 Coder",
          "limit": {
            "context": 1000000,
            "output": 16384
          },
          "options": {
            "provider": {
              "sort": "throughput"
            }
          }
        }
      }
    }
  },
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free"
}